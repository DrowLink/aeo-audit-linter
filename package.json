{
  "name": "aeo-linter-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Modular Answer Engine Optimization (AEO/GEO) Linter following the Google Lighthouse architecture",
  "workspaces": [
    "core",
    "cli",
    "extension"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --build --verbose",
    "publish:core": "npm publish ./core --access public",
    "publish:cli": "npm publish ./cli --access public",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.5"
  },
  "dependencies": {
    "aeo-linter": "^0.1.5"
  }
}
