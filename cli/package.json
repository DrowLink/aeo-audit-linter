  "keywords": [
    "aeo",
    "geo",
    "linter",
    "lighthouse",
    "cli"
  ],
  "author": "DrowLink",
  "license": "MIT",
  "dependencies": {
    "@drowlink/aeo-linter-core": "^0.1.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  }
}
