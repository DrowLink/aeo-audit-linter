{
  "name": "@drowlink/aeo-linter-core",
  "version": "0.1.5",
  "description": "Core engine and audit pipeline for AEO/GEO linter (Lighthouse architecture)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./config": {
      "types": "./dist/config/default-config.d.ts",
      "import": "./dist/config/default-config.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrowLink/aeo-audit-linter.git",
    "directory": "core"
  },
  "keywords": [
    "aeo",
    "geo",
    "linter",
    "lighthouse",
    "seo",
    "ai-search",
    "rag"
  ],
  "author": "DrowLink",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.5"
  }
}
