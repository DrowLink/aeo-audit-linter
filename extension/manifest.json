{
  "manifest_version": 3,
  "name": "AEO Linter - DevTools Panel",
  "version": "0.1.0",
  "description": "Linter modular para Answer Engine Optimization (AEO/GEO) en Chrome DevTools",
  "devtools_page": "devtools.html",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
