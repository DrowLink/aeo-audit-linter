{
  "manifest_version": 3,
  "name": "AEO Linter - Answer Engine Optimization",
  "version": "0.1.5",
  "description": "Automated Answer Engine Optimization (AEO/GEO) and RAG readiness auditing for web apps.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AEO Linter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "devtools_page": "devtools.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ]
}
